{
  "name": "cartify",
  "version": "1.0.0",
  "description": "Cartify - Mini E-Commerce App",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "npm run server --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "npm run dev --prefix backend",
    "data:import": "npm run data:import --prefix backend",
    "data:destroy": "npm run data:destroy --prefix backend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend"
  },
